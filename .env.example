# Copy this file to .env and fill in values for your local setup.
# Used by src/db_loader.py, src/bank_classifier.py, and src/predictions.py.

# MinIO connection (matches the minio service in docker-compose.yml)
MINIO_URL=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password

# Bucket and folder holding the manually uploaded train.csv / test.csv
# (see README "Loading data into MinIO" for upload instructions)
MINIO_BUCKET=bank-marketting-data
MINIO_DATA_FOLDER=data

# Local directory for the DuckLake catalog (catalog.ducklake, catalog_data/).
# Optional — defaults to the project root if unset.
# DUCKLAKE_DIR=/absolute/path/to/project
